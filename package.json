{
  "name": "tbank-dolyame-node",
  "version": "0.1.0",
  "description": "Typed Node.js client for T-Bank internet acquiring (EACQ v2) and the Dolyame partner API: request tokens, webhook verification, 54-FZ receipts, Russian root CA and mTLS handled.",
  "type": "module",
  "license": "MIT",
  "author": "Artem Svinoboev",
  "keywords": [
    "tbank",
    "tinkoff",
    "acquiring",
    "dolyame",
    "bnpl",
    "payments",
    "54-fz",
    "russian-trusted-ca",
    "mtls"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./certs/russian-trusted-root-ca.pem": "./certs/russian-trusted-root-ca.pem",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "certs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.0",
    "express": "^5.2.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KapaSique/tbank-dolyame-node.git"
  }
}
